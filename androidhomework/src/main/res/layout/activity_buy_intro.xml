<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <ListView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/lv_buy"
        android:layout_below="@+id/rv_buy_totalPrice"/>

    <RelativeLayout
        android:id="@+id/rv_buy_totalPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true">
        <TextView
            android:id="@+id/tv_buy_tmptotalPrice"
            android:paddingLeft="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总价格："
            android:textSize="30sp"
            android:textColor="@drawable/red"/>

        <TextView
            android:id="@+id/tv_buy_totalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_buy_tmptotalPrice"
            tools:text="199999.00"
            android:textSize="30sp"
            android:textColor="@drawable/red"
            android:layout_alignBaseline="@+id/tv_buy_tmptotalPrice"/>

    </RelativeLayout>


</RelativeLayout>